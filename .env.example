# Server environment. Copy to .env for local dev. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public base URL the app reaches (behind nginx in production)
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://vybe:vybe_dev_password@localhost:5432/vybe
# Separate DB used by the test suite (created automatically by test setup)
TEST_DATABASE_URL=postgresql://vybe:vybe_dev_password@localhost:5432/vybe_test
# >= 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Private media directory, outside any web root
MEDIA_DIR=./.media
# Number of trusted reverse-proxy hops (1 behind nginx, 0 locally)
TRUST_PROXY=0
LOG_LEVEL=info
# SMTP for verification/reset codes. Dev: Mailpit from docker-compose.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Vybe <no-reply@vybe.local>"
# Optional: comma-separated Google OAuth client IDs accepted as ID-token audience
GOOGLE_CLIENT_IDS=
# Optional: path to Firebase service-account JSON for FCM push
FCM_SERVICE_ACCOUNT_PATH=
# Web admin panel at /admin (needs an ADMIN account: node dist/cli/make-admin.js <email>). on | off
ADMIN_PANEL=on
