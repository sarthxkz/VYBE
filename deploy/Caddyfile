# HTTPS for the Vybe API. Caddy gets and renews the certificate itself (Let's Encrypt); WebSockets pass through.
{$PUBLIC_HOST} {
	encode gzip
	request_body {
		max_size 17MB
	}
	header -Server

	# App updates: static files uploaded by apps/mobile/scripts/publish.mjs (signed on the developer machine).
	handle /ota/* {
		root * /srv/public
		@manifest path */manifest
		header @manifest {
			Content-Type "multipart/mixed; boundary=vybe-ota"
			expo-protocol-version 1
			expo-sfv-version 0
			Cache-Control "private, max-age=0"
		}
		header /ota/assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /invite/* {
		root * /srv/public
		header Cache-Control "no-cache"
		file_server
	}
	handle /app/* {
		root * /srv/public
		header /app/android/latest.json Cache-Control "no-cache"
		header /app/android/*.apk {
			Content-Type application/vnd.android.package-archive
			Content-Disposition attachment
		}
		file_server
	}

	handle {
		reverse_proxy vybe-api:3000
	}
}
