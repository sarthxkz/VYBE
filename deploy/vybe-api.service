[Unit]
Description=Vybe API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vybe
Group=vybe
WorkingDirectory=/opt/vybe/apps/server
EnvironmentFile=/etc/vybe/vybe.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# Resource limits
MemoryMax=768M
LimitNOFILE=65536
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/vybe/media
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
