# Release APK built on Linux (no Windows 260-char path limit). From apps/mobile:
#   docker build -f Dockerfile.android --build-arg EXPO_PUBLIC_API_URL=https://api.example --output dist .
# The APK lands in dist/ UNSIGNED (the release key stays on the developer PC; see README "Releases & updates").
# Sign it with apksigner and ~/.vybe/vybe-release.jks before installing.
FROM node:24-bookworm AS sdk
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip && rm -rf /var/lib/apt/lists/*
ENV ANDROID_HOME=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
RUN curl -fsSL -o /tmp/tools.zip https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip \
 && mkdir -p $ANDROID_HOME/cmdline-tools && unzip -q /tmp/tools.zip -d $ANDROID_HOME/cmdline-tools \
 && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && rm /tmp/tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager "platform-tools" "platforms;android-37.0" "build-tools;37.0.0" "ndk;27.1.12297006" "cmake;4.1.2" >/dev/null

FROM sdk AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY . .
ARG EXPO_PUBLIC_API_URL
ENV APP_VARIANT=production EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL NODE_ENV=production
RUN npx expo prebuild -p android --clean --no-install
# arm64 only: every phone from the last ~8 years; add ABIs here if you need emulators/x86.
RUN --mount=type=cache,target=/root/.gradle cd android \
 && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a --no-daemon --console=plain \
    --max-workers=2 -Porg.gradle.parallel=false -Pkotlin.compiler.execution.strategy=in-process \
    "-Dorg.gradle.jvmargs=-Xmx3g -XX:MaxMetaspaceSize=1g"
# ^ capped parallelism: Docker Desktop's default VM (half of a 16 GB host) hung at full parallelism.

FROM scratch AS export
COPY --from=build /app/android/app/build/outputs/apk/release/app-release-unsigned.apk /vybe-release-unsigned.apk
